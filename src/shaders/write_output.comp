#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer AccumulationBuffer {
  float accumulation_values[];
};

layout(set = 0, binding = 1, std430) buffer OutputBuffer {
  uint output_words[];
};

layout(set = 0, binding = 2, std430) buffer DitherBuffer {
  float dither_values[];
};

layout(set = 0, binding = 3, std430) readonly buffer RandomBuffer {
  float random_values[];
};

layout(push_constant) uniform WriteOutputParams {
  uint accumulation_offset;
  uint accumulation_stride;
  uint output_stride_words;
  uint width;
  uint height;
  uint sample_kind;
  uint dither_mode;
  uint peak;
  uint reserved;
  float multiplier;
} params;

uint cast_u8(float value) {
  int sample_value = int(value + 0.5);
  return uint(clamp(sample_value, 0, 255));
}

uint cast_u16(float value) {
  int sample_value = int(value * params.multiplier + 0.5);
  return uint(clamp(sample_value, 0, int(params.peak)));
}

float accumulation_at(uint x, uint y) {
  return accumulation_values[params.accumulation_offset + y * params.accumulation_stride + x];
}

void write_u8_word(uint word_x, uint y) {
  uint base_x = word_x * 4u;
  if (base_x >= params.width) {
    return;
  }

  uint packed = 0u;
  for (uint lane = 0u; lane < 4u; ++lane) {
    uint x = base_x + lane;
    if (x < params.width) {
      packed |= cast_u8(accumulation_at(x, y)) << (lane * 8u);
    }
  }
  output_words[y * params.output_stride_words + word_x] = packed;
}

void write_u8_pixel(uint x, uint y, uint sample_value) {
  uint word_index = y * params.output_stride_words + (x >> 2u);
  uint shift = (x & 3u) * 8u;
  uint mask = 0xffu << shift;
  uint word = output_words[word_index];
  output_words[word_index] = (word & ~mask) | ((sample_value & 0xffu) << shift);
}

void write_dither_u8() {
  for (uint x = 0u; x < params.width; ++x) {
    dither_values[x] = 0.0;
  }

  float scale = float(params.dither_mode - 1u) + 0.5;
  float offset = scale * 0.5;

  for (uint y = 0u; y < params.height; ++y) {
    uint dc_base = (y & 1u) * params.width;
    uint dn_base = (1u - (y & 1u)) * params.width;
    for (uint x = 0u; x < params.width; ++x) {
      dither_values[dn_base + x] = 0.0;
    }

    for (uint x = 0u; x < params.width; ++x) {
      float source_value = accumulation_at(x, y);
      float noise = params.dither_mode == 1u ? 0.0 : random_values[y * params.width + x] * scale - offset;
      int candidate = int(source_value + noise + dither_values[dc_base + x] + 0.5);
      uint sample_value = uint(clamp(candidate, 0, 255));
      write_u8_pixel(x, y, sample_value);

      float qerror = source_value - float(sample_value);
      if (x != 0u) {
        dither_values[dn_base + x - 1u] += qerror * 0.1875;
      }
      dither_values[dn_base + x] += qerror * 0.3125;
      if (x + 1u < params.width) {
        dither_values[dc_base + x + 1u] += qerror * 0.4375;
        dither_values[dn_base + x + 1u] += qerror * 0.0625;
      }
    }
  }
}

void write_u16_word(uint word_x, uint y) {
  uint base_x = word_x * 2u;
  if (base_x >= params.width) {
    return;
  }

  uint packed = 0u;
  for (uint lane = 0u; lane < 2u; ++lane) {
    uint x = base_x + lane;
    if (x < params.width) {
      packed |= cast_u16(accumulation_at(x, y)) << (lane * 16u);
    }
  }
  output_words[y * params.output_stride_words + word_x] = packed;
}

void write_float_word(uint x, uint y) {
  if (x >= params.width) {
    return;
  }
  output_words[y * params.output_stride_words + x] = floatBitsToUint(accumulation_at(x, y) * (1.0 / 255.0));
}

void main() {
  uint word_x = gl_GlobalInvocationID.x;
  uint y = gl_GlobalInvocationID.y;

  if (params.sample_kind == 1u && params.dither_mode > 0u) {
    if (word_x == 0u && y == 0u) {
      write_dither_u8();
    }
    return;
  }

  if (word_x >= params.output_stride_words || y >= params.height) {
    return;
  }

  if (params.sample_kind == 1u) {
    write_u8_word(word_x, y);
    return;
  }
  if (params.sample_kind == 2u) {
    write_u16_word(word_x, y);
    return;
  }
  write_float_word(word_x, y);
}
